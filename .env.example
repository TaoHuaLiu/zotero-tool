# Copy to .env and fill in. Never commit .env.
# Key: https://www.zotero.org/settings/keys (give it write access to the group)
ZOTERO_API_KEY=
# Default group library (find IDs with `zotero-tool groups`)
ZOTERO_GROUP_ID=
# Optional: your user ID, only for --user (looked up from the key otherwise)
ZOTERO_USER_ID=
# Optional: own OpenAlex quota for `pdfs fetch` (https://openalex.org/settings/api)
OPENALEX_API_KEY=
